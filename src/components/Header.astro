---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { label: 'Beranda', href: '/' },
  { label: 'Destinasi Studi', href: '/destinasi-studi', children: [
    { label: 'United Kingdom (UK)', href: '/destinasi-studi' },
    { label: 'United States (USA)', href: '/destinasi-studi' },
    { label: 'Australia & New Zealand', href: '/destinasi-studi' },
    { label: 'Singapura, Kanada & Eropa', href: '/destinasi-studi' },
  ] },
  { label: 'Layanan Konsultasi', href: '/layanan-bimbingan' },
  { label: 'Beasiswa & Biaya', href: '/beasiswa-biaya' },
  { label: 'Kisah Sukses', href: '/#kisah-sukses' },
  { label: 'Acara & Edu Fair', href: '#' },
  { label: 'Tentang Kami', href: '#' },
];
const isActive = (href: string) => href === path;
const on = 'text-primary font-bold bg-surface-container-high rounded-lg';
const off = 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container rounded-lg';
---
<header class="fixed top-0 w-full z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(15,39,68,0.06)]">
  <div class="h-20 max-w-[90rem] mx-auto px-4 sm:px-6 xl:px-8 flex items-center justify-between gap-space-md">
    <a href="/" class="flex items-center gap-space-sm shrink-0" aria-label="Cosmo Education, ke beranda">
      <img alt="Cosmo Education" width="48" height="48" class="h-12 w-12 object-contain dark:hidden" src="/images/logo-light.png" />
      <img alt="Cosmo Education" width="48" height="48" class="h-12 w-12 object-contain hidden dark:block" src="/images/logo-dark.png" />
      <span class="font-headline-sm text-headline-sm text-primary tracking-tight font-bold hidden sm:inline-block xl:hidden 2xl:inline-block whitespace-nowrap">Cosmo Education</span>
    </a>

    <nav class="hidden xl:flex items-center gap-0.5 font-label-md text-label-md whitespace-nowrap" aria-label="Navigasi utama">
      {nav.map((item) =>
        item.children ? (
          <div class="relative group">
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class={`px-2 2xl:px-3 py-2 transition-colors whitespace-nowrap inline-flex items-center gap-1 ${isActive(item.href) ? on : off}`}>
              {item.label}<span class="material-symbols-outlined text-sm leading-none">expand_more</span>
            </a>
            <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block pt-2 w-56 z-50">
              <div class="bg-surface-container-lowest rounded-xl shadow-[0_12px_24px_-6px_rgba(15,39,68,0.12)] p-2 flex flex-col gap-1">
                {item.children.map((c) => (
                  <a href={c.href} class="px-3 py-2 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low rounded-lg transition-colors">{c.label}</a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class={`px-2 2xl:px-3 py-2 transition-colors whitespace-nowrap ${isActive(item.href) ? on : off}`}>{item.label}</a>
        )
      )}
    </nav>

    <div class="flex items-center gap-space-sm shrink-0">
      <a class="flex items-center gap-2 h-10 px-3 rounded-full bg-surface-container text-primary font-label-md text-label-md hover:bg-surface-container-high transition-colors whitespace-nowrap" href="https://wa.me/628161965707" target="_blank" rel="noopener noreferrer" aria-label="Chat WhatsApp Cosmo Education">
        <svg class="w-5 h-5 shrink-0 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        <span class="hidden sm:inline xl:hidden 2xl:inline">WhatsApp</span>
      </a>
      <a class="hidden sm:inline-block whitespace-nowrap px-4 py-2.5 rounded-lg bg-secondary-container text-on-secondary-container hover:bg-secondary hover:text-on-secondary font-label-md text-label-md font-bold transition-all shadow-[0_2px_8px_rgba(254,147,44,0.3)] active:scale-95" href="/#sesi-konsultasi">Konsultasi Gratis</a>
      <button id="theme-toggle" type="button" aria-label="Ganti tema terang atau gelap" class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors">
        <span class="material-symbols-outlined text-[20px] dark:hidden">dark_mode</span>
        <span class="material-symbols-outlined text-[20px] hidden dark:inline-block">light_mode</span>
      </button>
      <button id="menu-toggle" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-drawer" class="xl:hidden w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors">
        <span class="material-symbols-outlined text-[22px]">menu</span>
      </button>
    </div>
  </div>

  <div id="mobile-drawer" class="hidden xl:hidden border-t border-outline-variant/40 bg-surface">
    <nav class="max-w-7xl mx-auto px-6 py-4 flex flex-col gap-1 font-label-lg text-label-lg" aria-label="Navigasi seluler">
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class={`px-3 py-3 ${isActive(item.href) ? on : off}`}>{item.label}</a>
      ))}
      <a href="/#sesi-konsultasi" class="mt-2 px-4 py-3 rounded-lg bg-secondary-container text-on-secondary-container font-bold text-center">Konsultasi Gratis</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var drawer = document.getElementById('mobile-drawer');
    btn.addEventListener('click', function () {
      var open = drawer.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });
    drawer.addEventListener('click', function (e) {
      if (e.target.closest('a')) { drawer.classList.add('hidden'); btn.setAttribute('aria-expanded', 'false'); }
    });
    document.getElementById('theme-toggle').addEventListener('click', function () {
      var dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
    });
  })();
</script>
