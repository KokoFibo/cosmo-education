<script is:inline>
(function () {
    // Dynamic Calculator Logic
    const degreeSelect = document.getElementById('degree-select');
    const countrySelect = document.getElementById('country-select');
    const gpaRange = document.getElementById('gpa-range');
    const gpaDisplay = document.getElementById('gpa-display');
    const englishRange = document.getElementById('english-range');
    const englishDisplay = document.getElementById('english-display');

    const calcTierBadge = document.getElementById('calc-tier-badge');
    const calcGrossCost = document.getElementById('calc-gross-cost');
    const calcScholarshipVal = document.getElementById('calc-scholarship-val');
    const calcNetCost = document.getElementById('calc-net-cost');
    const matchedList = document.getElementById('matched-scholarships-list');

    // Baseline costs in million IDR
    const baseCosts = {
      uk: { bachelor: 540, master: 510, doctorate: 470, pathway: 420 },
      aus: { bachelor: 580, master: 540, doctorate: 490, pathway: 430 },
      usa: { bachelor: 720, master: 680, doctorate: 590, pathway: 510 },
      ger: { bachelor: 220, master: 210, doctorate: 190, pathway: 200 },
      can: { bachelor: 490, master: 460, doctorate: 410, pathway: 380 },
      jpn: { bachelor: 260, master: 240, doctorate: 210, pathway: 230 }
    };

    function updateCalculator() {
      const gpa = parseFloat(gpaRange.value);
      const eng = parseFloat(englishRange.value);
      const degree = degreeSelect.value;
      const country = countrySelect.value;

      gpaDisplay.textContent = gpa.toFixed(2);
      englishDisplay.textContent = eng.toFixed(1);

      const grossMio = (baseCosts[country] && baseCosts[country][degree]) || 500;

      let tierText = 'Rendah: Jalur Mandiri';
      let discountRate = 0.10;
      let recommendedHTML = '';

      if (gpa >= 3.75 && eng >= 7.0) {
        tierText = 'Sangat Tinggi: Full / Fully Funded Potensial';
        discountRate = 0.70;
        recommendedHTML = `
          <div class="p-3 rounded-lg bg-surface-container-lowest flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary">workspace_premium</span>
              <div>
                <div class="font-label-md text-label-md text-primary">${country === 'uk' ? 'Chevening Scholarship (UK)' : country === 'aus' ? 'Australia Awards (AAS)' : country === 'usa' ? 'Fulbright Award' : country === 'ger' ? 'DAAD Research Grant' : 'LPDP Reguler Top 100'}</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant">Fully Funded · Penuh 100% Biaya &amp; Hidup</div>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm font-bold">Peluang Top</span>
          </div>
          <div class="p-3 rounded-lg bg-surface-container-lowest flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary">verified</span>
              <div>
                <div class="font-label-md text-label-md text-primary">LPDP Reguler / BIM Afirmasi</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant">Fully Funded Kementerian Keuangan</div>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded bg-surface-container-high text-primary font-label-sm text-label-sm font-bold">Sangat Cocok</span>
          </div>
          <div class="p-3 rounded-lg bg-surface-container-lowest flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary">school</span>
              <div>
                <div class="font-label-md text-label-md text-primary">Chancellor's Merit Award 50%</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant">Diskon SPP Universitas Garansi Profil</div>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded bg-surface-container-high text-primary font-label-sm text-label-sm font-bold">Otomatis</span>
          </div>
        `;
      } else if (gpa >= 3.40 && eng >= 6.5) {
        tierText = 'Tinggi: Partial 30% - 50% SPP';
        discountRate = 0.40;
        recommendedHTML = `
          <div class="p-3 rounded-lg bg-surface-container-lowest flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary">school</span>
              <div>
                <div class="font-label-md text-label-md text-primary">Global Excellence Scholarship</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant">Potongan Uang Kuliah 25% - 50% Otomatis</div>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm font-bold">Prioritas Mitra</span>
          </div>
          <div class="p-3 rounded-lg bg-surface-container-lowest flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary">verified</span>
              <div>
                <div class="font-label-md text-label-md text-primary">LPDP Parsial (Co-Funding)</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant">Pendanaan Biaya Hidup atau SPP Mandiri</div>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded bg-surface-container-high text-primary font-label-sm text-label-sm font-bold">Tinggi</span>
          </div>
        `;
      } else if (gpa >= 3.00 && eng >= 6.0) {
        tierText = 'Menengah: Beasiswa Universitas 15% - 25%';
        discountRate = 0.20;
        recommendedHTML = `
          <div class="p-3 rounded-lg bg-surface-container-lowest flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary">school</span>
              <div>
                <div class="font-label-md text-label-md text-primary">Early Bird &amp; Regional Merit Bursary</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant">Potongan Langsung £3.000 - AUD $7.500 Thn Pertama</div>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm font-bold">Pasti Dapat</span>
          </div>
        `;
      } else {
        tierText = 'Rendah / Jalur Pathway Bursary';
        discountRate = 0.10;
        recommendedHTML = `
          <div class="p-3 rounded-lg bg-surface-container-lowest flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary">school</span>
              <div>
                <div class="font-label-md text-label-md text-primary">Pathway Progression Bursary</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant">Potongan program persiapan bahasa/diploma 10% - 15%</div>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded bg-surface-container-high text-primary font-label-sm text-label-sm font-bold">Tersedia</span>
          </div>
        `;
      }

      const discValMio = Math.round(grossMio * discountRate);
      const netValMio = grossMio - discValMio;

      calcTierBadge.textContent = tierText;
      calcGrossCost.textContent = 'Rp ' + grossMio.toLocaleString('id-ID') + '.000.000';
      calcScholarshipVal.textContent = '- Rp ' + discValMio.toLocaleString('id-ID') + '.000.000';
      calcNetCost.textContent = 'Rp ' + netValMio.toLocaleString('id-ID') + '.000.000 / thn';
      matchedList.innerHTML = recommendedHTML;
    }

    gpaRange.addEventListener('input', updateCalculator);
    englishRange.addEventListener('input', updateCalculator);
    degreeSelect.addEventListener('change', updateCalculator);
    countrySelect.addEventListener('change', updateCalculator);

    updateCalculator();

    // Directory Filtering
    const filterBtns = document.querySelectorAll('#dir-filters button');
    const cards = document.querySelectorAll('.scholarship-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', function () {
        filterBtns.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary');
          b.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
        this.classList.remove('bg-surface-container', 'text-on-surface-variant');
        this.classList.add('bg-primary', 'text-on-primary');

        const filter = this.getAttribute('data-filter');
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  })();
</script>
</Layout>
