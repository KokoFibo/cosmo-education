<!-- INTERACTIVE BEHAVIOR SCRIPT -->
</main>
<script is:inline>
(function() {
    // 1. Country Filter Interactivity
    const countryButtons = document.querySelectorAll('.filter-country-btn');
    const destinationCards = document.querySelectorAll('.destination-card');
    const filterCounter = document.getElementById('activeFilterCounter');

    countryButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle Active Styling on buttons
        countryButtons.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
          b.classList.add('bg-surface-container-low', 'text-on-surface');
        });
        btn.classList.remove('bg-surface-container-low', 'text-on-surface');
        btn.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');

        const selectedCountry = btn.getAttribute('data-country');
        let visibleCount = 0;

        destinationCards.forEach(card => {
          const cardCountry = card.getAttribute('data-country');
          if (selectedCountry === 'all' || selectedCountry === cardCountry) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (filterCounter) {
          filterCounter.textContent = selectedCountry === 'all' 
            ? 'Menampilkan 5 Wilayah Utama' 
            : `Menampilkan ${visibleCount} Kartu Destinasi Terpilih`;
        }
      });
    });

    // 2. Chip selectors toggle effect (Level & Discipline)
    const toggleChips = (selector) => {
      document.querySelectorAll(selector).forEach(chip => {
        chip.addEventListener('click', () => {
          document.querySelectorAll(selector).forEach(c => {
            c.classList.remove('bg-primary', 'text-on-primary', 'shadow-xs');
            c.classList.add('bg-surface-container', 'text-primary');
          });
          chip.classList.remove('bg-surface-container', 'text-primary');
          chip.classList.add('bg-primary', 'text-on-primary', 'shadow-xs');
        });
      });
    };
    toggleChips('.level-chip');
    toggleChips('.discipline-chip');

    // 3. Reset Filter Handler
    const resetBtn = document.getElementById('resetFilterBtn');
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        const defaultAllBtn = document.querySelector('.filter-country-btn[data-country="all"]');
        if (defaultAllBtn) defaultAllBtn.click();
      });
    }

    // 4. Intake Timeline Tabs Switcher
    const btnFall = document.getElementById('btnIntakeFall');
    const btnSpring = document.getElementById('btnIntakeSpring');
    const contentFall = document.getElementById('contentIntakeFall');
    const contentSpring = document.getElementById('contentIntakeSpring');

    if (btnFall && btnSpring && contentFall && contentSpring) {
      btnFall.addEventListener('click', () => {
        btnFall.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-xs', 'font-bold');
        btnFall.classList.remove('text-on-surface-variant');
        btnSpring.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-xs', 'font-bold');
        btnSpring.classList.add('text-on-surface-variant');
        contentFall.classList.remove('hidden');
        contentSpring.classList.add('hidden');
      });

      btnSpring.addEventListener('click', () => {
        btnSpring.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-xs', 'font-bold');
        btnSpring.classList.remove('text-on-surface-variant');
        btnFall.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-xs', 'font-bold');
        btnFall.classList.add('text-on-surface-variant');
        contentSpring.classList.remove('hidden');
        contentFall.classList.add('hidden');
      });
    }
  })();
</script>
