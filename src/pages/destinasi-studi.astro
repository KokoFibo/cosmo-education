---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Destinasi Studi | Cosmo Education">
<main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]"><div class="flex flex-col w-full">
<!-- HERO EDITORIAL TITLE & GLOBAL INTRO -->
<section class="relative w-full overflow-hidden bg-gradient-to-b from-surface-container-high/40 via-surface to-surface pb-12 pt-8">
<div class="max-w-7xl mx-auto px-6 lg:px-12">
<!-- Micro Breadcrumb & Global Badge -->
<div class="flex items-center gap-3 mb-6">
<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-highest text-primary font-label-sm text-label-sm">
<span class="material-symbols-outlined text-sm leading-none text-secondary" style="font-variation-settings: 'FILL' 1;">public</span>
          Official Partner 450+ Universitas Dunia
        </span>
<span class="text-outline font-label-sm text-label-sm">•</span>
<span class="text-on-surface-variant font-label-sm text-label-sm">Panduan Intake 2025/2026</span>
</div>
<!-- Main Title Block with Editorial Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
<div class="lg:col-span-8 flex flex-col gap-4">
<h1 class="font-display-lg text-display-lg text-primary tracking-tight">
            Eksplorasi Destinasi <br class="hidden sm:inline"/>
<span class="text-secondary">Studi Terbaik</span> di Dunia.
          </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
            Rancang jalur akademik internasional Anda secara presisi. Bandingkan izin kerja pasca-studi (PSW/OPT), prospek karir global, regulasi visa pelajar, serta kalkulasi realistis biaya hidup dan beasiswa.
          </p>
</div>
<!-- Metric Snapshot Cards (Top Right Offset) -->
<div class="lg:col-span-4 flex flex-col gap-3 bg-surface-container-lowest p-6 rounded-xl shadow-sm">
<div class="flex items-center justify-between">
<span class="font-label-md text-label-md text-on-surface-variant">Tingkat Kelulusan Visa 2024</span>
<span class="font-headline-sm text-headline-sm text-secondary">98.4%</span>
</div>
<!-- Inline Sparkline / Progress Bar -->
<div class="w-full bg-surface-container h-2 rounded-full overflow-hidden">
<div class="bg-secondary h-full rounded-full w-[98.4%]"></div>
</div>
<div class="grid grid-cols-2 gap-4 pt-2">
<div>
<div class="font-headline-md text-headline-md text-primary font-bold">18+</div>
<div class="font-body-sm text-body-sm text-on-surface-variant">Negara Tujuan</div>
</div>
<div>
<div class="font-headline-md text-headline-md text-primary font-bold">Rp 42M+</div>
<div class="font-body-sm text-body-sm text-on-surface-variant">Beasiswa Dimenangkan</div>
</div>
</div>
</div>
</div>
<!-- INTERACTIVE QUICK FILTER BAR -->
<div class="mt-12 bg-surface-container-lowest p-6 lg:p-8 rounded-2xl shadow-md flex flex-col gap-6">
<!-- Row 1: Negara Destinasi Chips -->
<div>
<div class="flex items-center justify-between mb-3">
<span class="font-label-md text-label-md text-primary uppercase tracking-wider font-bold flex items-center gap-1.5">
<span class="material-symbols-outlined text-base leading-none text-secondary">flag</span>
              Negara Tujuan
            </span>
<span class="font-label-sm text-label-sm text-on-surface-variant" id="activeFilterCounter">Menampilkan 5 Wilayah Utama</span>
</div>
<div class="flex flex-wrap gap-2" id="countryFilterContainer">
<button class="filter-country-btn px-4 py-2 rounded-full font-label-md text-label-md transition-all bg-primary text-on-primary shadow-sm" data-country="all">Semua Negara</button>
<button class="filter-country-btn px-4 py-2 rounded-full font-label-md text-label-md transition-all bg-surface-container-low text-on-surface hover:bg-surface-container-high" data-country="uk">Inggris (UK)</button>
<button class="filter-country-btn px-4 py-2 rounded-full font-label-md text-label-md transition-all bg-surface-container-low text-on-surface hover:bg-surface-container-high" data-country="aus">Australia &amp; NZ</button>
<button class="filter-country-btn px-4 py-2 rounded-full font-label-md text-label-md transition-all bg-surface-container-low text-on-surface hover:bg-surface-container-high" data-country="usa">Amerika Serikat</button>
<button class="filter-country-btn px-4 py-2 rounded-full font-label-md text-label-md transition-all bg-surface-container-low text-on-surface hover:bg-surface-container-high" data-country="can">Kanada</button>
<button class="filter-country-btn px-4 py-2 rounded-full font-label-md text-label-md transition-all bg-surface-container-low text-on-surface hover:bg-surface-container-high" data-country="ger">Jerman &amp; Eropa</button>
<button class="filter-country-btn px-4 py-2 rounded-full font-label-md text-label-md transition-all bg-surface-container-low text-on-surface hover:bg-surface-container-high" data-country="sg">Singapura</button>
</div>
</div>
<!-- Row 2: Jenjang & Bidang Minat Selectors -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-4 pt-4 bg-surface-container-low/50 p-4 rounded-xl">
<!-- Jenjang Studi -->
<div class="lg:col-span-5 flex flex-col gap-2">
<label class="font-label-sm text-label-sm text-on-surface-variant font-bold flex items-center gap-1.5">
<span class="material-symbols-outlined text-base leading-none text-secondary">school</span>
              Jenjang Program
            </label>
<div class="flex flex-wrap gap-1.5">
<button class="level-chip px-3 py-1.5 rounded-lg text-label-sm font-label-sm bg-surface-container text-primary hover:bg-surface-container-high active:scale-95 transition-all">Foundation / Pathway</button>
<button class="level-chip px-3 py-1.5 rounded-lg text-label-sm font-label-sm bg-primary text-on-primary shadow-xs">S1 / Bachelor</button>
<button class="level-chip px-3 py-1.5 rounded-lg text-label-sm font-label-sm bg-surface-container text-primary hover:bg-surface-container-high">S2 / Master</button>
<button class="level-chip px-3 py-1.5 rounded-lg text-label-sm font-label-sm bg-surface-container text-primary hover:bg-surface-container-high">S3 / Doctoral</button>
</div>
</div>
<!-- Bidang Minat -->
<div class="lg:col-span-5 flex flex-col gap-2">
<label class="font-label-sm text-label-sm text-on-surface-variant font-bold flex items-center gap-1.5">
<span class="material-symbols-outlined text-base leading-none text-secondary">category</span>
              Bidang Minat Prioritas
            </label>
<div class="flex flex-wrap gap-1.5">
<button class="discipline-chip px-3 py-1.5 rounded-lg text-label-sm font-label-sm bg-primary text-on-primary">Engineering &amp; AI</button>
<button class="discipline-chip px-3 py-1.5 rounded-lg text-label-sm font-label-sm bg-surface-container text-primary hover:bg-surface-container-high">Business &amp; Finance</button>
<button class="discipline-chip px-3 py-1.5 rounded-lg text-label-sm font-label-sm bg-surface-container text-primary hover:bg-surface-container-high">Health &amp; Medicine</button>
<button class="discipline-chip px-3 py-1.5 rounded-lg text-label-sm font-label-sm bg-surface-container text-primary hover:bg-surface-container-high">Arts &amp; Design</button>
</div>
</div>
<!-- Search or Reset CTA -->
<div class="lg:col-span-2 flex items-end">
<button class="w-full h-11 px-4 rounded-lg bg-surface-container hover:bg-surface-container-high text-primary font-label-md text-label-md flex items-center justify-center gap-2 transition-all" id="resetFilterBtn">
<span class="material-symbols-outlined text-base leading-none">restart_alt</span>
              Reset Filter
            </button>
</div>
</div>
</div>
</div>
</section>
<!-- DESTINATIONS MOSAIC & CURATED CARDS -->
<section class="max-w-7xl mx-auto px-6 lg:px-12 py-12 w-full">
<div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
<div>
<span class="text-secondary font-label-md text-label-md uppercase tracking-wider font-bold">Direktori Lengkap</span>
<h2 class="font-headline-xl text-headline-xl text-primary">Destinasi &amp; Institusi Unggulan</h2>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant max-w-md">
        Informasi terakreditasi mengenai izin kerja pasca-studi, skema pembiayaan, serta universitas mitra unggulan Cosmo Education.
      </p>
</div>
<!-- Country Cards Grid -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8" id="destinationsGrid">
<!-- CARD 1: UNITED KINGDOM (Featured Wide / 7 Columns) -->
<article class="destination-card lg:col-span-7 bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all flex flex-col justify-between" data-country="uk">
<div>
<!-- Image Header with Flags & Accreditations -->
<div class="relative h-64 w-full overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" data-alt="Majestic historic architecture of Oxford and Cambridge universities with students walking across sunny lawns surrounded by grand neo-gothic spires and modern libraries under a soft blue British sky." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCj6_FwKYnWB7SUl85gQd-TUm589hxtoIofc60oEsKkgZT54hz-KEZu3LFKhX4yRKIIh2BzW2OsVZW4iEuRLOHgUiM1pNtKiSRPNG4LCZiPmMptL1wepLD4ik_vPW3Sj2mfdVjV_R9RFf3fUigBS80xE9XhESA3kWIWGKf63bGxQ4J-cpJwgw4tGglG_-CdDA8ylf9rfAYpxdYyKEwpT36WzkrDp_Mk8Y040bTFvIr_JKrsTs43iINqGw"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-transparent"></div>
<div class="absolute top-4 left-4 flex gap-2">
<span class="px-3 py-1 rounded-full bg-surface/90 backdrop-blur-md text-primary font-label-sm text-label-sm font-bold shadow-xs">
                🇬🇧 United Kingdom
              </span>
<span class="px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-bold">
                Russell Group Hub
              </span>
</div>
<div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-on-primary">
<div>
<span class="font-label-sm text-label-sm opacity-90">Izin Pasca Kelulusan</span>
<p class="font-headline-sm text-headline-sm font-bold text-white">Graduate Route: 2 - 3 Tahun</p>
</div>
<div class="text-right">
<span class="font-label-sm text-label-sm opacity-90">Rata-rata Durasi S1</span>
<p class="font-headline-sm text-headline-sm font-bold text-white">3 Tahun (Fast-track)</p>
</div>
</div>
</div>
<!-- Content Body -->
<div class="p-6 lg:p-8 flex flex-col gap-6">
<div class="flex flex-col gap-2">
<h3 class="font-headline-lg text-headline-lg text-primary">Inggris (United Kingdom)</h3>
<p class="font-body-md text-body-md text-on-surface-variant">
                Pusat keunggulan akademis berstandar global dengan tradisi berabad-abad. Program Master selesai hanya dalam 1 tahun dan Sarjana 3 tahun, menghemat biaya hidup signifikan dibandingkan destinasi lain.
              </p>
</div>
<!-- Key Metrics Grid -->
<div class="grid grid-cols-2 sm:grid-cols-3 gap-4 bg-surface-container-low p-4 rounded-xl">
<div>
<span class="font-label-sm text-label-sm text-outline block">Tuition Fee / Thn</span>
<span class="font-headline-sm text-headline-sm text-primary font-bold">£18,000 - £35,000</span>
</div>
<div>
<span class="font-label-sm text-label-sm text-outline block">Biaya Hidup / Bln</span>
<span class="font-headline-sm text-headline-sm text-primary font-bold">£1,100 - £1,500</span>
</div>
<div class="col-span-2 sm:col-span-1">
<span class="font-label-sm text-label-sm text-outline block">Kerja Sampingan</span>
<span class="font-headline-sm text-headline-sm text-secondary font-bold">20 Jam / Minggu</span>
</div>
</div>
<!-- Partner Institutions Badges -->
<div>
<span class="font-label-sm text-label-sm text-on-surface-variant font-bold uppercase tracking-wider block mb-2">Universitas Mitra Utama:</span>
<div class="flex flex-wrap gap-2">
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">University of Oxford</span>
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">Imperial College London</span>
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">UCL</span>
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">Univ of Manchester</span>
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">King's College London</span>
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">Univ of Edinburgh</span>
</div>
</div>
</div>
</div>
<div class="p-6 lg:p-8 pt-0 flex items-center justify-between">
<a class="inline-flex items-center gap-2 font-label-md text-label-md text-secondary hover:text-on-secondary-container font-bold" href="#">
            Pelajari Prosedur UCAS &amp; Visa UK
            <span class="material-symbols-outlined text-base">arrow_forward</span>
</a>
<span class="text-outline font-label-sm text-label-sm">Intake: Sept &amp; Jan</span>
</div>
</article>
<!-- CARD 2: AUSTRALIA & NEW ZEALAND (5 Columns) -->
<article class="destination-card lg:col-span-5 bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all flex flex-col justify-between" data-country="aus">
<div>
<div class="relative h-64 w-full overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" data-alt="Modern Australian university campus in Melbourne with sunny courtyard, diverse international students collaborating on laptops near eucalyptus trees and architectural glass buildings." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCMQ1VS2-_o_izo-G8PZaLFM0DYBd_JvuW8N0TFa8MXa5lE8qbLcR38opxxXccKAreIT6UCMH5Gzbh5ltRazlyoRFsqC5SKYf7O1BBmT3JQWGEyJlAZ-uL2qDd-MxGDBuKzMvecXuLSjh8C5LH_h9xqiidY9QgCmXGTDad6z8yxDWZbU33kBvZvoRV81loqWJczcUFpTy0Q2yxwksiA2bd1iuqvxgcJT8qIIU7giUa9MlMzoJrI7rCRLg"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-transparent"></div>
<div class="absolute top-4 left-4 flex gap-2">
<span class="px-3 py-1 rounded-full bg-surface/90 backdrop-blur-md text-primary font-label-sm text-label-sm font-bold shadow-xs">
                🇦🇺 Australia &amp; 🇳🇿 NZ
              </span>
<span class="px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-bold">
                Group of Eight (Go8)
              </span>
</div>
<div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-on-primary">
<div>
<span class="font-label-sm text-label-sm opacity-90">Post-Study Work</span>
<p class="font-headline-sm text-headline-sm font-bold text-white">2 - 4 Tahun (Subclass 485)</p>
</div>
<div class="text-right">
<span class="font-label-sm text-label-sm opacity-90">Part-Time Work</span>
<p class="font-headline-sm text-headline-sm font-bold text-white">48 Jam / 2 Minggu</p>
</div>
</div>
</div>
<div class="p-6 lg:p-8 flex flex-col gap-6">
<div class="flex flex-col gap-2">
<h3 class="font-headline-lg text-headline-lg text-primary">Australia &amp; New Zealand</h3>
<p class="font-body-md text-body-md text-on-surface-variant">
                Destinasi favorit mahasiswa Indonesia berkat kualitas hidup tinggi, iklim ramah, dan jalur kerja pasca-kelulusan yang sangat fleksibel di kota metropolitan maupun regional.
              </p>
</div>
<div class="grid grid-cols-2 gap-4 bg-surface-container-low p-4 rounded-xl">
<div>
<span class="font-label-sm text-label-sm text-outline block">Tuition Fee / Thn</span>
<span class="font-headline-sm text-headline-sm text-primary font-bold">AUD 33,000 - 48,000</span>
</div>
<div>
<span class="font-label-sm text-label-sm text-outline block">Biaya Hidup / Bln</span>
<span class="font-headline-sm text-headline-sm text-primary font-bold">AUD 1,900 - 2,500</span>
</div>
</div>
<div>
<span class="font-label-sm text-label-sm text-on-surface-variant font-bold uppercase tracking-wider block mb-2">Universitas Mitra Utama:</span>
<div class="flex flex-wrap gap-2">
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">Univ of Melbourne</span>
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">UNSW Sydney</span>
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">Univ of Sydney</span>
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">Monash University</span>
<span class="px-2.5 py-1 rounded bg-surface-container font-label-md text-label-md text-primary">Univ of Auckland</span>
</div>
</div>
</div>
</div>
<div class="p-6 lg:p-8 pt-0 flex items-center justify-between">
<a class="inline-flex items-center gap-2 font-label-md text-label-md text-secondary hover:text-on-secondary-container font-bold" href="#">
            Detail Intake Feb &amp; Juli
            <span class="material-symbols-outlined text-base">arrow_forward</span>
</a>
<span class="text-outline font-label-sm text-label-sm">Go8 Certified</span>
</div>
</article>
<!-- CARD 3: USA (4 Columns) -->
<article class="destination-card lg:col-span-4 bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all flex flex-col justify-between" data-country="usa">
<div>
<div class="relative h-56 w-full overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" data-alt="High tech American research university campus with innovation laboratory, students working on robotics, warm afternoon lighting with prestigious academic brick buildings in background." src="https://lh3.googleusercontent.com/aida-public/AB6AXuATqDX1z02Z75DYwavNTeE2-GIeGyBNEasirfe8iB9Y3xnbXw98LqoEOmQrwwMRr_e1MUwZsjTOK6e2wNec6kO3NSzajoBFRATJnSZPL2XUfn5WpJQ2QMj-CO7iT2TFnb5g-8hbxCj9jERK9lbWQ0_UdZOER94hoVwUzWm3VcAbsKQTYxkCorCHnQPbaweItPjJeZEJMKYJsWSMMFvrehEbyJBKmM-kDHlmF90KvnoXetniQ5-yxGr1pQ"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-transparent"></div>
<div class="absolute top-4 left-4 flex gap-2">
<span class="px-3 py-1 rounded-full bg-surface/90 backdrop-blur-md text-primary font-label-sm text-label-sm font-bold shadow-xs">
                🇺🇸 United States
              </span>
</div>
<div class="absolute bottom-4 left-4 right-4 text-on-primary">
<span class="font-label-sm text-label-sm opacity-90">Keunggulan Utama</span>
<p class="font-headline-sm text-headline-sm font-bold text-white">STEM OPT Hingga 3 Tahun</p>
</div>
</div>
<div class="p-6 flex flex-col gap-4">
<h3 class="font-headline-md text-headline-md text-primary">Amerika Serikat (USA)</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant">
              Kiblat inovasi, teknologi, dan ekosistem riset terbesar di dunia. Fleksibilitas memilih major/minor ganda serta peluang asistensi riset (GRA/GTA) dengan pendanaan penuh.
            </p>
<div class="bg-surface-container-low p-3.5 rounded-xl flex flex-col gap-1.5">
<div class="flex justify-between">
<span class="font-body-sm text-body-sm text-on-surface-variant">Tuition Rata-rata</span>
<span class="font-label-md text-label-md text-primary font-bold">$28,000 - $60,000 / thn</span>
</div>
<div class="flex justify-between">
<span class="font-body-sm text-body-sm text-on-surface-variant">Biaya Hidup</span>
<span class="font-label-md text-label-md text-primary font-bold">$1,400 - $2,200 / bln</span>
</div>
</div>
<div class="flex flex-wrap gap-1.5 pt-1">
<span class="px-2 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-primary">MIT</span>
<span class="px-2 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-primary">Columbia Univ</span>
<span class="px-2 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-primary">UC Berkeley</span>
<span class="px-2 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-primary">NYU</span>
<span class="px-2 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-primary">Purdue Univ</span>
</div>
</div>
</div>
<div class="p-6 pt-0">
<a class="inline-flex items-center gap-1.5 font-label-md text-label-md text-secondary hover:text-on-secondary-container font-bold" href="#">
            Panduan SAT &amp; F-1 Visa
            <span class="material-symbols-outlined text-base">arrow_forward</span>
</a>
</div>
</article>
<!-- CARD 4: CANADA (4 Columns) -->
<article class="destination-card lg:col-span-4 bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all flex flex-col justify-between" data-country="can">
<div>
<div class="relative h-56 w-full overflow-hidden">
<img class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" data-alt="Scenic Canadian university campus in Vancouver or Toronto with snow-capped mountain backdrop and maple trees, students studying near modern glass library." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDx7OwQ9gGG2HLvkV3dpmuh9TPlFDzy3Cvba2Sli3XtWmpvImR2ha9MI1bqdxBbX4k7QYieotODtdOjLqvg8t6Ld-3MLKUV2Ge8z2qBt5C3RKoUBc9N3kkm898o_59VHbi_BivGYiwyWKt276EtNZLTCfWaOjPE3oNoeiOxp0iBBbs00n1_DlKCYJ60VBuOrdGG5siysrVr1bxhCE1IQfkSbSeahzWdG4cKsnd88hUqUOaOL6LX50-_AA"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/20 to-transparent"></div>
<div class="absolute top-4 left-4 flex gap-2">
<span class="px-3 py-1 rounded-full bg-surface/90 backdrop-blur-md text-primary font-label-sm text-label-sm font-bold shadow-xs">
                🇨🇦 Canada
              </span>
</div>
<div class="absolute bottom-4 left-4 right-4 text-on-primary">
<span class="font-label-sm text-label-sm opacity-90">Keunggulan Utama</span>
<p class="font-headline-sm text-headline-sm font-bold text-white">PGWP 3 Tahun &amp; Opsi PR</p>
</div>
</div>
<div class="p-6 flex flex-col gap-4">
