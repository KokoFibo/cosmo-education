<script is:inline>
function handleProgramSearch() {
      const jenjang = document.getElementById('hero-jenjang').options[document.getElementById('hero-jenjang').selectedIndex].text;
      const negara = document.getElementById('hero-negara').options[document.getElementById('hero-negara').selectedIndex].text;
      const bidang = document.getElementById('hero-bidang').options[document.getElementById('hero-bidang').selectedIndex].text;

      const alertBox = document.getElementById('search-alert');
      const alertText = document.getElementById('search-result-text');

      alertText.textContent = `Ditemukan 110+ program ${jenjang} untuk bidang ${bidang} di ${negara} dengan kuota beasiswa aktif!`;
      alertBox.classList.remove('hidden');

      alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    let currentGPA = '3.6';

    function selectGPA(btn, val) {
      currentGPA = val;
      const buttons = document.querySelectorAll('.gpa-btn');
      buttons.forEach(b => {
        b.classList.remove('bg-primary', 'text-on-primary');
        b.classList.add('bg-surface-container', 'text-primary');
      });
      btn.classList.remove('bg-surface-container', 'text-primary');
      btn.classList.add('bg-primary', 'text-on-primary');
      recalculateScholarship();
    }

    function recalculateScholarship() {
      const ielts = document.getElementById('calc-ielts').value;
      const destination = document.getElementById('calc-destination').value;
      const titleElem = document.getElementById('scholarship-result-title');
      const descElem = document.getElementById('scholarship-result-desc');

      if (currentGPA === '3.9' && (ielts === '7.0' || ielts === '7.5')) {
        titleElem.textContent = 'Potongan 50% - 100% Tuition Fee (Full Merit)';
        descElem.textContent = `Sangat direkomendasikan untuk skema Global Excellence Scholarship di ${destination} dan beasiswa institusi pemerintah.`;
      } else if (currentGPA === '3.6') {
        titleElem.textContent = 'Potongan 20% - 40% Tuition Fee';
        descElem.textContent = `Kandidat kuat untuk Vice-Chancellor International Scholarship dan Dean's Award di universitas mitra ${destination}.`;
      } else {
        titleElem.textContent = 'Beasiswa Parsial $5,000 - $12,000 / thn';
        descElem.textContent = `Peluang early-bird grant dan otomatisasi potongan SPP untuk pendaftaran intake semester pertama di ${destination}.`;
      }
    }

    function handleFormSubmit(e) {
      e.preventDefault();
      document.getElementById('form-content').classList.add('hidden');
      document.getElementById('form-success').classList.remove('hidden');
    }

    function resetBookingForm() {
      document.getElementById('booking-form').reset();
      document.getElementById('form-success').classList.add('hidden');
      document.getElementById('form-content').classList.remove('hidden');
    }
</script>
