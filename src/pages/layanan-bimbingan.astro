<script is:inline>
function switchStep(index) {
      // Update buttons
      const buttons = document.querySelectorAll('#step-tabs .step-btn');
      buttons.forEach((btn, idx) => {
        const circle = btn.querySelector('span:first-child');
        if (idx === index) {
          btn.className = 'step-btn px-5 py-3 rounded-full font-label-md text-label-md transition-all shadow-sm flex items-center gap-2 bg-primary text-on-primary';
          circle.className = 'w-6 h-6 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center text-xs font-bold';
        } else {
          btn.className = 'step-btn px-5 py-3 rounded-full font-label-md text-label-md transition-all flex items-center gap-2 bg-surface-container text-on-surface hover:bg-surface-container-high';
          circle.className = 'w-6 h-6 rounded-full bg-surface-container-highest text-primary flex items-center justify-center text-xs font-bold';
        }
      });

      // Update panels
      for (let i = 0; i < 5; i++) {
        const panel = document.getElementById('step-panel-' + i);
        if (panel) {
          if (i === index) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        }
      }
    }

    function toggleFaq(card) {
      const answer = card.querySelector('.faq-answer');
      const icon = card.querySelector('.faq-icon');
      if (answer.classList.contains('hidden')) {
        answer.classList.remove('hidden');
        icon.classList.add('rotate-180');
      } else {
        answer.classList.add('hidden');
        icon.classList.remove('rotate-180');
      }
    }

    function handleBookingSubmit(event) {
      event.preventDefault();
      alert('Terima kasih! Jadwal konsultasi profil Anda telah berhasil dikonfirmasi. Konselor resmi Cosmo Education akan menghubungi Anda melalui WhatsApp.');
      event.target.reset();
    }
</script>
